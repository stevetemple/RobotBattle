<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\RobotBattle.Engine\RobotBattle.Engine.csproj" />
    <ProjectReference Include="..\RobotBattle.Api\RobotBattle.Api.csproj" />
    <ProjectReference Include="..\RobotBattle.Compiler\RobotBattle.Compiler.csproj" />
    <ProjectReference Include="..\RobotBattle.Host\RobotBattle.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Player-facing sample robots live in /samples at the repo root; they are served via /api/samples. -->
    <Content Include="../../samples/*.cs" Link="samples/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
